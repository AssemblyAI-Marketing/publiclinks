# Google OAuth (add <BASE_URL>/auth/callback as an authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=assemblyai.com
SECRET_KEY=generate-a-random-secret-key

# Postgres (set automatically when Neon is connected via the Vercel Marketplace).
# Leave empty locally to use a SQLite file.
DATABASE_URL=

# Public URLs. Both fall back to the request host if unset.
BASE_URL=https://your-app.example.com
SHORT_BASE_URL=https://your-short-domain.com

# Cloudflare R2 (optional — enables file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# Only needed for the one-off import (POST /api/admin/import)
DUB_API_KEY=
DUB_DOMAIN=your-short-domain.com
